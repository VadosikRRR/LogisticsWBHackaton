# API Gateway
API_PORT=8080
AGGREGATOR_URL=http://localhost:8081
DISPATCH_URL=http://localhost:8082
TRANSPORT_URL=http://localhost:8083

# Host ports for docker-compose
API_HOST_PORT=18080
AGGREGATOR_HOST_PORT=18081
DISPATCH_HOST_PORT=18082
TRANSPORT_HOST_PORT=18083
POSTGRES_HOST_PORT=55432
REDIS_HOST_PORT=56379
RABBITMQ_HOST_PORT=55672
RABBITMQ_MANAGEMENT_HOST_PORT=55673

# Aggregator / Transport Postgres
DATABASE_URL=postgres://postgres:postgres@localhost:5432/logistics?sslmode=disable
POSTGRES_MAX_CONNS=20
POSTGRES_MIN_CONNS=2
POSTGRES_CONNECT_TIMEOUT=5s
POSTGRES_HEALTHCHECK_PERIOD=30s

# Dispatch
DISPATCH_PORT=8082
ML_BACKEND_URL=http://localhost:8000
DISPATCH_USE_MOCK_ML=true
DISPATCH_DEFAULT_WINDOW_LIMIT=14000
DISPATCH_VEHICLE_CAPACITY=20
DISPATCH_SAFETY_BUFFER=0.15
DISPATCH_MAX_VEHICLES_PER_SLOT=100

# Redis
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_DIAL_TIMEOUT=3s
REDIS_READ_TIMEOUT=2s
REDIS_WRITE_TIMEOUT=2s

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=transport.events
